# Production-образ фронтенда
# Сборка: docker build -f Dockerfile.prod -t <DOCKER_USER>/questions-frontend:latest .

# --- Этап 1: сборка React-приложения ---
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Пустой VITE_API_URL → запросы на тот же хост; nginx проксирует /llm на backend
ENV VITE_API_URL=
RUN npm run build

# --- Этап 2: раздача статики через nginx ---
FROM nginx:alpine

# Имя upstream backend задано в nginx.conf — должно совпадать с именем сервиса в compose
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

DOCKER_USER=your-docker-hub-username

BASE_URL=https://api.proxyapi.ru/openai/v1
API_KEY=your_proxyapi_key
MODEL=gpt-4o
REQUEST_TIMEOUT=30
MAX_TEXT_CHARS=12000

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Production (nginx проксирует /llm на тот же хост) — CORS для UI не нужен.
# Добавляйте IP/домен только если API вызывают с другого origin (отдельный фронт).
# CORS_ORIGINS=http://<IP_СЕРВЕРА>,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

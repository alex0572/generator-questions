BASE_URL=https://api.proxyapi.ru/openai/v1
API_KEY=your_proxyapi_key
MODEL=gpt-4o
REQUEST_TIMEOUT=30
MAX_TEXT_CHARS=12000

# Логирование: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
# Путь к файлу логов (необязательно; пусто — только консоль)
LOG_FILE=logs/app.log

# CORS: нужен только при dev (фронт :5173 → API :8000) или отдельном фронте.
# В production через nginx на одном домене — менять не обязательно.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
